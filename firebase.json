{
  "functions": [
    {
      "source": "electrotag/web/firebase/functions",
      "codebase": "electrotag",
      "runtime": "python313",
      "ignore": ["venv", ".git", "__pycache__", "*.pyc"],
      "predeploy": ["node \"$RESOURCE_DIR/../../../../scripts/predeploy_functions.mjs\" \"$RESOURCE_DIR\""]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "europe-west2"
  },
  "hosting": {
    "public": "electrotag/web/static",
    "ignore": ["config.json", "**/.*"],
    "headers": [
      {"source": "**", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "emulators": {
    "auth": {"port": 9099},
    "firestore": {"port": 8080},
    "functions": {"port": 5001},
    "ui": {"enabled": false},
    "singleProjectMode": true
  }
}
